<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_attendance_distribution_list" model="ir.ui.view">
    <field name="name">sb.attendance.report.distribution.list</field>
    <field name="model">sb.attendance.report.distribution</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="channel_id"/><field name="automatic_enabled"/></list></field>
  </record>
  <record id="view_attendance_distribution_form" model="ir.ui.view">
    <field name="name">sb.attendance.report.distribution.form</field>
    <field name="model">sb.attendance.report.distribution</field>
    <field name="arch" type="xml">
      <form string="Attendance Report Distribution">
        <header><button name="action_send_test" type="object" string="Send Test Report" class="btn-primary"/><button name="action_send_now" type="object" string="Send Now"/></header>
        <sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group>
          <group string="Distribution Channels"><field name="channel_id" options="{'no_create': True}"/><field name="send_pdf"/><field name="send_excel"/></group>
          <group string="Email Recipients"><field name="sender_email"/><field name="user_ids" widget="many2many_tags"/><field name="external_emails" placeholder="recipient@example.com, other@example.com"/></group>
          <group string="Automation"><field name="automatic_enabled"/><field name="send_hour"/><field name="send_minute"/><div class="text-muted">Time is South African Standard Time (SAST). The scheduler checks every five minutes.</div></group>
          <notebook><page string="Distribution History"><field name="log_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="date"/><field name="status"/><field name="is_test"/><field name="pending_count"/><field name="recipient_emails"/><field name="mail_id"/></list></field></page></notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_attendance_distribution" model="ir.actions.act_window"><field name="name">Report Distribution</field><field name="res_model">sb.attendance.report.distribution</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_attendance_distribution" name="Report Distribution" parent="menu_attendance_administration" action="action_attendance_distribution" sequence="35" groups="sb_daily_attendance.group_attendance_admin"/>
</odoo>
