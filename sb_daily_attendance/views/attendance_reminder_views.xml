<odoo>
  <record id="view_attendance_reminder_config_form" model="ir.ui.view">
    <field name="name">sb.attendance.reminder.config.form</field>
    <field name="model">sb.attendance.reminder.config</field>
    <field name="arch" type="xml"><form string="Attendance Notifications"><header><button name="action_send_sample" type="object" string="Send Sample Notification" class="btn-primary"/><button name="action_test_now" type="object" string="Test Actual Foreman Reminders"/><button name="action_test_escalation_now" type="object" string="Test Actual Escalations"/></header><sheet><group><field name="company_id" options="{'no_create': True}"/><field name="enabled"/><field name="weekdays_only"/></group><group string="Sample Notification Test"><field name="sample_user_id" options="{&apos;no_create&apos;: True}"/><field name="sample_stage"/></group><group string="Recipients"><field name="hr_user_ids" widget="many2many_tags"/><field name="manager_user_ids" widget="many2many_tags"/></group><div class="alert alert-info" role="alert">Automatic checks run every five minutes. First reminder from 10:05, escalation from 11:00 (Africa/Johannesburg). Sample tests can simulate either notification stage without modifying attendance or real notification history. Actual reminder and escalation tests send genuine Discuss notifications for today's outstanding teams, subject to duplicate prevention. The system never finalises attendance.</div></sheet></form></field>
  </record>
  <record id="view_attendance_reminder_config_list" model="ir.ui.view"><field name="name">sb.attendance.reminder.config.list</field><field name="model">sb.attendance.reminder.config</field><field name="arch" type="xml"><list><field name="company_id"/><field name="enabled"/><field name="weekdays_only"/></list></field></record>
  <record id="action_attendance_reminder_config" model="ir.actions.act_window"><field name="name">Attendance Notification Settings</field><field name="res_model">sb.attendance.reminder.config</field><field name="view_mode">list,form</field></record>
  <record id="view_attendance_reminder_log_list" model="ir.ui.view"><field name="name">sb.attendance.reminder.log.list</field><field name="model">sb.attendance.reminder.log</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="sent_at"/><field name="attendance_date"/><field name="team_id"/><field name="stage"/><field name="recipient_user_ids" widget="many2many_tags"/><field name="note"/></list></field></record>
  <record id="action_attendance_reminder_log" model="ir.actions.act_window"><field name="name">Attendance Notification History</field><field name="res_model">sb.attendance.reminder.log</field><field name="view_mode">list</field></record>
  <menuitem id="menu_attendance_reminder_config" name="Notification Settings" parent="sb_daily_attendance.menu_attendance_administration" action="action_attendance_reminder_config" groups="sb_daily_attendance.group_attendance_admin" sequence="95"/>
  <menuitem id="menu_attendance_reminder_log" name="Notification History" parent="sb_daily_attendance.menu_attendance_administration" action="action_attendance_reminder_log" groups="sb_daily_attendance.group_attendance_admin" sequence="96"/>
</odoo>