<odoo>
  <record id="view_public_holiday_list" model="ir.ui.view">
    <field name="name">sb.attendance.public.holiday.list</field>
    <field name="model">sb.attendance.public.holiday</field>
    <field name="arch" type="xml">
      <list string="South African Public Holidays" create="1" delete="0">
        <field name="holiday_date"/>
        <field name="name"/>
        <field name="year"/>
        <field name="source"/>
        <field name="verified_on" optional="show"/>
      </list>
    </field>
  </record>
  <record id="view_public_holiday_form" model="ir.ui.view">
    <field name="name">sb.attendance.public.holiday.form</field>
    <field name="model">sb.attendance.public.holiday</field>
    <field name="arch" type="xml">
      <form string="Public Holiday" delete="0">
        <sheet>
          <group>
            <field name="holiday_date"/>
            <field name="name"/>
            <field name="year"/>
            <field name="source" readonly="1"/>
            <field name="verified_on" readonly="1"/>
          </group>
          <div class="text-muted">Use Overtime Rules → Synchronise Public Holidays to refresh imported dates. Manually added exceptional holidays are retained.</div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_public_holidays" model="ir.actions.act_window">
    <field name="name">Public Holidays</field>
    <field name="res_model">sb.attendance.public.holiday</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'default_year': context_today().year}</field>
  </record>
  <menuitem id="menu_public_holidays" name="Public Holidays" parent="menu_attendance_administration" action="action_public_holidays" sequence="45" groups="sb_daily_attendance.group_attendance_admin"/>
</odoo>
